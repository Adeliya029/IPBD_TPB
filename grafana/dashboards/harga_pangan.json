      "title": "💰 Analisis Harga",
      "type": "row"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Top 10 komoditas termahal",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "currencyIDR",
          "decimals": 0
        }
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 6 },
      "id": 201,
      "options": {
        "displayMode": "list",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["mean"] },
        "showUnfilled": true,
        "text": {}
      },
      "targets": [{
        "datasource": "PostgreSQL",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT komoditas, ROUND(AVG(harga)) as value FROM harga_pangan_raw WHERE harga > 0 GROUP BY komoditas ORDER BY value DESC LIMIT 10",
        "refId": "A"
      }],
      "title": "Top 10 Komoditas Termahal",
      "type": "bargauge"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Tren harga per komoditas (pilih dari dropdown)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "unit": "currencyIDR"
        }
      },
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 6 },
      "id": 202,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [{
        "datasource": "PostgreSQL",
        "format": "time_series",
        "rawQuery": true,
        "rawSql": "SELECT tanggal AS time, ROUND(AVG(harga)) AS value, komoditas AS metric FROM harga_pangan_raw WHERE komoditas IN ('Beras Medium', 'Beras Premium', 'Cabai Merah Besar', 'Cabai Rawit Merah', 'Daging Sapi Paha Belakang', 'Minyak Goreng Sawit Curah') AND harga > 0 GROUP BY tanggal, komoditas ORDER BY tanggal",
        "refId": "A"
      }],
      "title": "Tren Harga — Komoditas Utama",
      "type": "timeseries"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Heatmap perubahan harga per komoditas per bulan (hijau=turun, merah=naik)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": -1 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "komoditas" },
            "properties": [{ "id": "custom.displayMode", "value": "auto" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "id": 203,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "komoditas" }]
      },
      "targets": [{
        "datasource": "PostgreSQL",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT komoditas, ROUND(AVG(CASE WHEN EXTRACT(MONTH FROM tanggal)=1 THEN harga_change_pct END)::numeric, 1) AS Jan, ROUND(AVG(CASE WHEN EXTRACT(MONTH FROM tanggal)=2 THEN harga_change_pct END)::numeric, 1) AS Feb, ROUND(AVG(CASE WHEN EXTRACT(MONTH FROM tanggal)=3 THEN harga_change_pct END)::numeric, 1) AS Mar, ROUND(AVG(CASE WHEN EXTRACT(MONTH FROM tanggal)=4 THEN harga_change_pct END)::numeric, 1) AS Apr, ROUND(AVG(CASE WHEN EXTRACT(MONTH FROM tanggal)=5 THEN harga_change_pct END)::numeric, 1) AS May FROM cuaca_harga_merged WHERE harga_change_pct IS NOT NULL GROUP BY komoditas ORDER BY komoditas",
        "refId": "A"
      }],
      "title": "📊 Heatmap Perubahan Harga per Bulan (%)",
      "type": "table"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Volatilitas harga per komoditas (STDDEV)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
