    {
      "datasource": "PostgreSQL",
      "description": "Ranking provinsi berdasarkan rata-rata harga",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg_harga" },
            "properties": [
              { "id": "unit", "value": "currencyIDR" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "avg_change" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 27 },
      "id": 301,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "avg_harga" }]
      },
      "targets": [{
        "datasource": "PostgreSQL",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT CASE p.provinsi WHEN '31' THEN 'DKI Jakarta' WHEN '32' THEN 'Jawa Barat' WHEN '33' THEN 'Jawa Tengah' WHEN '34' THEN 'DI Yogyakarta' WHEN '35' THEN 'Jawa Timur' WHEN '36' THEN 'Banten' END AS provinsi, ROUND(AVG(p.harga)) AS avg_harga, COUNT(DISTINCT p.komoditas) AS komoditas, COUNT(DISTINCT p.kab_kota) AS kab_kota, ROUND(AVG(m.harga_change_pct)::numeric, 1) AS avg_change FROM harga_pangan_raw p LEFT JOIN cuaca_harga_merged m ON p.tanggal = m.tanggal AND p.kab_kota = m.kab_kota AND p.komoditas = m.komoditas WHERE p.harga > 0 GROUP BY p.provinsi ORDER BY avg_harga DESC",
        "refId": "A"
      }],
      "title": "🏆 Ranking Provinsi",
      "type": "table"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Detail harga per kabupaten/kota",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "harga" },
