        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "harga" }]
      },
      "targets": [{
        "datasource": "PostgreSQL",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT p.kab_kota, CASE p.provinsi WHEN '31' THEN 'DKI Jakarta' WHEN '32' THEN 'Jawa Barat' WHEN '33' THEN 'Jawa Tengah' WHEN '34' THEN 'DI Yogyakarta' WHEN '35' THEN 'Jawa Timur' WHEN '36' THEN 'Banten' END AS prov, p.komoditas, ROUND(AVG(p.harga)) AS harga, COUNT(*) AS hari FROM harga_pangan_raw p WHERE p.harga > 0 GROUP BY p.kab_kota, p.provinsi, p.komoditas HAVING COUNT(*) > 5 ORDER BY harga DESC LIMIT 50",
        "refId": "A"
