        "rawSql": "SELECT kab_kota, CASE provinsi WHEN '31' THEN 'DKI' WHEN '32' THEN 'Jabar' WHEN '33' THEN 'Jateng' WHEN '34' THEN 'DIY' WHEN '35' THEN 'Jatim' WHEN '36' THEN 'Banten' END AS prov, ROUND(suhu_mean::numeric,1) as suhu_mean, ROUND(curah_hujan_mm::numeric,1) as hujan_mm, ROUND(kelembapan::numeric,0) as lembab, ROUND(kecepatan_angin::numeric,1) as angin, cluster_nama, waktu FROM cuaca_realtime ORDER BY waktu DESC LIMIT 30",
