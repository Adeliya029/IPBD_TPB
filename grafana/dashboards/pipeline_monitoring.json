{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dashboard monitoring pipeline data pangan — batch runs, stream events, log severity, alerts, dan resource usage",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 Pipeline Overview",
      "type": "row"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Total pipeline batch yang pernah dijalankan",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "blue", "value": 10 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT pipeline_run_id) as value FROM audit_log WHERE operasi = 'INSERT' AND tabel_nama = 'batch_pipeline'",
          "refId": "A"
        }
      ],
      "title": "🔄 Total Pipeline Runs",
      "type": "stat"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Pipeline berhasil vs gagal",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM audit_log WHERE tabel_nama LIKE 'pipeline_step%' AND data_sesudah::json->>'status' = 'SUCCESS'",
          "refId": "A"
        }
      ],
      "title": "✅ Steps Berhasil",
      "type": "stat"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Jumlah step pipeline yang gagal",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM audit_log WHERE tabel_nama LIKE 'pipeline_step%' AND data_sesudah::json->>'status' = 'FAILED'",
          "refId": "A"
        }
      ],
      "title": "❌ Steps Gagal",
      "type": "stat"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Alert yang belum resolved",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM alerts WHERE is_resolved = FALSE",
          "refId": "A"
        }
      ],
      "title": "🚨 Alert Aktif",
      "type": "stat"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Total record data harga pangan di database",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM harga_pangan_raw",
          "refId": "A"
        }
      ],
      "title": "📦 Records Harga Pangan",
      "type": "stat"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Total record cuaca realtime masuk dari streaming",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM cuaca_realtime",
          "refId": "A"
        }
      ],
      "title": "🌊 Records Stream (Cuaca Realtime)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📊 Batch Pipeline — Riwayat Eksekusi",
      "type": "row"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Riwayat semua pipeline run dengan status masing-masing step",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "SUCCESS": { "color": "green", "index": 0, "text": "✅ SUCCESS" } }, "type": "value" },
                  { "options": { "FAILED": { "color": "red", "index": 1, "text": "❌ FAILED" } }, "type": "value" },
                  { "options": { "COMPLETED": { "color": "blue", "index": 2, "text": "🔵 COMPLETED" } }, "type": "value" }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "created_at" }]
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pipeline_run_id, tabel_nama as step, operasi, username, data_sesudah::json->>'status' as status, created_at FROM audit_log ORDER BY created_at DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "📋 Riwayat Audit Log Pipeline",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "⚠️ Alert System",
      "type": "row"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Distribusi alert berdasarkan severity",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 8,
      "options": {
        "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT severity, COUNT(*) as value FROM alerts GROUP BY severity ORDER BY value DESC",
          "refId": "A"
        }
      ],
      "title": "🎯 Distribusi Alert per Severity",
      "type": "piechart"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Distribusi alert berdasarkan tipe",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 9,
      "options": {
        "displayLabels": ["percent", "name"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT alert_type, COUNT(*) as value FROM alerts GROUP BY alert_type ORDER BY value DESC",
          "refId": "A"
        }
      ],
      "title": "📊 Distribusi Alert per Tipe",
      "type": "piechart"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Daftar alert aktif yang belum resolved",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "CRITICAL": { "color": "red", "index": 0 } }, "type": "value" },
                  { "options": { "WARNING": { "color": "yellow", "index": 1 } }, "type": "value" },
                  { "options": { "INFO": { "color": "blue", "index": 2 } }, "type": "value" }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 10,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "created_at" }]
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id, alert_type, severity, SUBSTRING(message, 1, 60) as message, komoditas, provinsi, created_at FROM alerts WHERE is_resolved = FALSE ORDER BY created_at DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "🚨 Alert Aktif (Belum Resolved)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "🖥️ System Resources (Prometheus)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "CPU usage sistem host",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "id": 11,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "system_cpu_usage_percent",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "title": "🖥️ CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Memory usage sistem host",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "id": 12,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "system_memory_usage_percent",
          "legendFormat": "Memory %",
          "refId": "A"
        }
      ],
      "title": "💾 Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Total pesan Kafka yang berhasil diproses pipeline",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "id": 13,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(weather_messages_processed_total[1m])",
          "legendFormat": "{{city}} - {{status}}",
          "refId": "A"
        }
      ],
      "title": "📨 Stream Events per Menit",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104,
      "title": "🌊 Stream Processing",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Total prediksi ML yang dibuat sejak pipeline berjalan",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 31 },
      "id": 14,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(ml_predictions_total[5m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "🤖 ML Predictions per 5 Menit",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Pipeline errors berdasarkan komponen dan tipe error",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 31 },
      "id": 15,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(pipeline_errors_total[5m])",
          "legendFormat": "{{component}} - {{error_type}}",
          "refId": "A"
        }
      ],
      "title": "❌ Pipeline Errors per 5 Menit",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 105,
      "title": "📝 Log Execution",
      "type": "row"
    },
    {
      "datasource": "PostgreSQL",
      "description": "Ringkasan eksekusi pipeline: waktu mulai, selesai, durasi, dan status tiap run",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "id": 16,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "created_at" }]
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pipeline_run_id, username, operasi, tabel_nama as step, data_sesudah::json->>'status' as status, data_sesudah::json->>'start_time' as start_time, data_sesudah::json->>'end_time' as end_time, created_at FROM audit_log ORDER BY created_at DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "📝 Log Execution Detail",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ipbd", "pipeline", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "🔍 Pipeline Monitoring — IPBD Harga Pangan",
  "uid": "ipbd-pipeline-monitoring",
  "version": 1
}
